	pages = {1--6},
	file = {PDF:C\:\\Users\\brian\\Zotero\\storage\\UHUZ9LRP\\Hu et al. - 2019 - A Fixed-Switching-Frequency Sliding Mode Current Controller for Mutually Coupled Switched Reluctance.pdf:application/pdf},
