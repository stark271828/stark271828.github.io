	author = {Guo, Lulu and Ye, Jin and Yang, Bowen},
	month = sep,
	year = {2021},
	keywords = {Power electronics, Torque, Mechanical power transmission, Security, Computer security, cyber–physical security, Cyberattack detection, electric vehicles (EVs), Physics, physics-guided machine learning, power-train system in EVs, Predictive models},
	pages = {2010--2022},
	file = {PDF:C\:\\Users\\brian\\Zotero\\storage\\6KNJHJBX\\Guo et al. - 2021 - Cyberattack Detection for Electric Vehicles Using Physics-Guided Machine Learning.pdf:application/pdf},
