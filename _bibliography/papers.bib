@inproceedings{yang_dynamic_2026,
	title = {Dynamic {Output} {Impedance} of {Grid}-{Forming} {Inverters} under {Current} {Limiting}},
	url = {https://ieeexplore.ieee.org/abstract/document/11596629},
	doi = {10.23919/IPEC-Nagasaki2026-EC64663.2026.11596629},
	abstract = {As inverter-based resources (IBRs) proliferate, gridforming (GFM) inverters are drawing increasing attention for their ability to establish and maintain grid voltage and frequency, capabilities that conventional grid-following (GFL) inverters face challenges in providing. A key challenge for GFM inverters, however, is their strict overcurrent limit. When current limiting activates, the GFM inverter can no longer track its internal voltage reference, resulting in a sustained control tracking error that can drive controller windup and jeopardize stability. Antiwindup strategies, such as clamping and back-calculation, are therefore required for mitigation. These mechanisms alter the inverter dynamics and can compromise its voltage-source behavior, requiring further study. This work models these effects through a variable equivalent impedance placed between the ideal internal voltage source representing the primary control and the actual inverter terminal voltage resulting from the current limiting and anti-windup. This paper presents a unified framework developed to derive the equivalent impedance for different current-limiting and anti-windup schemes, characterize the resultant dynamic impedance profiles, and evaluate GFM inverter performance under current limiting in terms of (i) local bus voltage regulation and (ii) active and reactive power provision to the grid through simulations.},
	urldate = {2026-09-25},
	booktitle = {2026 {International} {Power} {Electronics} {Conference} ({IPEC}-{Nagasaki} 2026 - {ECCE} {Asia})},
	author = {Yang, Bowen and Yang, Yongheng and Seo, Gab-Su},
