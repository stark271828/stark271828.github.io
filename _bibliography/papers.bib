@inproceedings{dutta_decentralized_2025,
	title = {A {Decentralized} {Soft}-start {Method} for a {Cascaded} {H}-{Bridge} and {Quad} {Active} {Bridge}-based {Medium} {Voltage} {AC}-{DC} {Converter}},
