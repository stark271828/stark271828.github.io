	keywords = {grid-forming inverters, inverter-based resources, small-signal stability, grid-following inverters, inverter-dominated power systems, power system stability},
	pages = {3645},
	file = {PDF:C\:\\Users\\brian\\Zotero\\storage\\WWZRNZ33\\Samanta et al. - 2025 - Stability Analysis of Power Systems with High Penetration of State-of-the-Art Inverter Technologies.pdf:application/pdf},
