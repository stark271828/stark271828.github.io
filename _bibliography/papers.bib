	year = {2025},
	keywords = {Inverters, Power system stability, stability, Transient analysis, Grid-forming inverter, Limiting, Current limiters, Grid forming, current limiting, Frequency control, Stability criteria, frequency stabilization, Numerical models, Numerical stability, equivalent impedance},
	pages = {602--608},
	file = {PDF:C\:\\Users\\brian\\Zotero\\storage\\C8Y94W5C\\Yang and Seo - 2025 - Stability Analysis of Current-Limited Grid-Forming Inverters with Frequency Stabilization An Equiva.pdf:application/pdf},
