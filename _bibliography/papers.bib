@article{guo_attack-resilient_2022,
	title = {Attack-{Resilient} {Lateral} {Stability} {Control} for {Four}-{Wheel}-{Driven} {EVs} {Considering} {Changed} {Driver} {Behavior} {Under} {Cyber} {Threats}},
